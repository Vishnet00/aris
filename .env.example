# A.R.I.S. Configuration
# Copy this to .env and fill in your values

# Choose backend: "openai" or "hermes"
BACKEND=openai

# OpenAI-compatible API (for BACKEND=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat

# Hermes CLI path (for BACKEND=hermes)
HERMES_BIN=/usr/local/lib/hermes-agent/venv/bin/hermes
HERMES_MODEL=deepseek/deepseek-chat

# Server port
PORT=8892
